node_modules/
.Memento/sessions/

# 客户端构建产物：由 `npm run build:renderer` 生成
#   renderer/dist/  —— React + Streamdown + Tailwind 打成一个 bundle
#   preload.cjs     —— preload.ts 打成的自包含 CommonJS（沙箱 preload 只认 CJS）
app/desktop/renderer/dist/
app/desktop/preload.cjs

# 本地密钥：任何情况下都不要提交
.env
.env.local

# 打包 staging（`npm run app:build` 生成：生产依赖 + 运行时文件，交给 Electron Forge）
build/

# Electron Forge 的产物（.app / .zip / .dmg）
out/

# scratch 工作区：临时脚本、实验日志、浏览器 profile、评审截图。
/.tmp/*
# 例外：这是 `/ip-as-logo` 命令（`.agents/commands/ip-as-logo.md`）明确引用的
# 可复现工具链 —— 它不进构建，但少了它那条命令就跑不起来，所以留在仓库里。
!/.tmp/ip-as-logo/

# 本地安装的第三方技能：软链到仓库外的稳定路径（如 ~/Developer/video-use）。
# 提交出去会变成一个指向**本机绝对路径**的坏软链，所以只留本地；
# 换机器重装就是重建这个软链（`ln -sfn <路径> .agents/skills/<名字>`）。
# 与之相对，仓库自带的技能（report / yuanmy-* 等）是 vendored 进来的，照常入库。
/.agents/skills/video-use
