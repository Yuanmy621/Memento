{
  // Node 侧 **.js** 文件的归属。
  //
  // 现在只剩 opencli 适配器（`app/opencli/**`）：它们**必须**是 .js ——
  // opencli 只发现 `~/.opencli/clis/<site>/<命令>.js`，不认 .ts（见 app/opencli/README.md）。
  // 其余客户端代码（主进程 / preload / ipc / 构建脚本）已经全部是 .ts，
  // 归根 tsconfig 的严格检查。
  //
  // checkJs 关掉：它**不负责查错**，只负责让编辑器和 tsc 都「认领」这些文件 ——
  // 否则它们不属于任何项目，VS Code 会拿推断项目去解析，报出
  // 「找不到名称 "node:fs/promises"，请安装 @types/node」这种误导性错误（真报过）。
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app/opencli/**/*.js"],
  "exclude": ["node_modules/**"]
}
