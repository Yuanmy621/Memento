{
  "name": "Memento",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal coding agent built on the DeepSeek Harness kernel",
  "main": "app/desktop/main.ts",
  "type": "module",
  "scripts": {
    "start": "node app/cli/main.ts",
    "build:renderer": "node app/desktop/scripts/build-renderer.ts",
    "desktop": "npm run build:renderer && electron app/desktop/main.ts",
    "desktop:watch": "node app/desktop/scripts/build-renderer.ts --watch",
    "app:build": "npm run build:renderer && node app/desktop/scripts/build-app.ts",
    "package": "npm run app:build && electron-forge package build/app",
    "make": "npm run app:build && electron-forge make build/app",
    "desktop:host": "node app/desktop/host/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/desktop/renderer/tsconfig.json && tsc --noEmit -p tsconfig.js.json",
    "mcp:butian": "node app/mcp/butian/server.ts",
    "mcp:vulbox": "node app/mcp/vulbox/server.ts",
    "desktop:butian": "Memento_MCP=butian npm run desktop",
    "desktop:vulbox": "Memento_MCP=vulbox npm run desktop",
    "desktop:src": "Memento_MCP=butian:vulbox npm run desktop",
    "opencli:install": "node app/opencli/install.js",
    "audit:css": "node app/desktop/scripts/audit-css.ts"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
